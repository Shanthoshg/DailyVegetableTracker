
@model DailyVegetableTracker.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Vegetable Tracker</h1>
            <p class="text-muted mb-0">
                Your daily vegetable spending overview
            </p>
        </div>
        <a asp-controller="Purchases"
           asp-action="Create"
           class="btn btn-success">
            + Add Purchase
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Today's Spending</p>
                    <h3 class="fw-bold text-success">
                        ₹@Model.TodaySpending.ToString("N2")
                    </h3>
                    <small class="text-muted">
                        @Model.TodayPurchaseCount purchases
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">This Month</p>
                    <h3 class="fw-bold text-primary">
                        ₹@Model.MonthSpending.ToString("N2")
                    </h3>
                    <small class="text-muted">
                        @Model.MonthPurchaseCount purchases
                    </small>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Vegetables Tracked</p>
                    <h3 class="fw-bold">
                        @ViewBag.VegetableCount
                    </h3>
                    <a asp-controller="Vegetables"
                       asp-action="Index"
                       class="small">
                        Manage vegetables
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Average Purchase</p>
                    <h3 class="fw-bold text-warning">
                        ₹@((Model.MonthPurchaseCount > 0
                            ? Model.MonthSpending / Model.MonthPurchaseCount
                            : 0m).ToString("N2"))
                    </h3>
                    <small class="text-muted">This month</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">Recent Purchases</h5>
                </div>

                <div class="card-body p-0">
                    @if (Model.RecentPurchases.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date</th>
                                        <th>Vegetable</th>
                                        <th>Quantity</th>
                                        <th>Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var purchase in Model.RecentPurchases)
                                    {
                                        <tr>
                                            <td>
                                                @purchase.PurchaseDate.ToString("dd MMM yyyy")
                                            </td>
                                            <td>
                                                @(purchase.Vegetable?.Name ?? "Unknown")
                                            </td>
                                            <td>
                                                @purchase.Quantity @purchase.Unit
                                            </td>
                                            <td class="fw-semibold">
                                                ₹@purchase.TotalCost.ToString("N2")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <p class="mb-2">No purchases yet.</p>
                            <p class="small">Add your first purchase to see it here.</p>
                        </div>
                    }
                </div>

                <div class="card-footer bg-white">
                    <a asp-controller="Purchases"
                       asp-action="Index"
                       class="text-decoration-none">
                        View all purchases →
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">Spending by Vegetable</h5>
                    <small class="text-muted">Current month</small>
                </div>

                <div class="card-body">
                    @if (Model.SpendingByVegetable.Any())
                    {
                        @foreach (var item in Model.SpendingByVegetable)
                        {
                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <span>@item.VegetableName</span>
                                    <strong>₹@item.TotalSpent.ToString("N2")</strong>
                                </div>

                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar bg-success"
                                         role="progressbar"
                                         style="width: @(Model.MonthSpending > 0
                                             ? (double)(item.TotalSpent / Model.MonthSpending * 100)
                                             : 0)%"
                                         aria-valuenow="@(Model.MonthSpending > 0
                                             ? (double)(item.TotalSpent / Model.MonthSpending * 100)
                                             : 0)"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted text-center py-4">
                            No spending data for this month yet.
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<hr />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>My Vegetables</h2>
    <a asp-controller="Vegetables"
       asp-action="Create"
       class="btn btn-success">
        + Add Vegetable
    </a>
</div>

@if (Model.Vegetables != null && Model.Vegetables.Any())
{
    <div class="row">
        @foreach (var vegetable in Model.Vegetables)
        {
            <div class="col-md-4 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">
                            @vegetable.Name
                        </h5>

                        <p class="card-text">
                            Category:
                            @(string.IsNullOrWhiteSpace(vegetable.Category)
                                ? "Not specified"
                                : vegetable.Category)
                        </p>

                        <p class="card-text">
                            Unit: @vegetable.Unit
                        </p>

                        <a asp-controller="Vegetables"
                           asp-action="Details"
                           asp-route-id="@vegetable.Id"
                           class="btn btn-outline-primary btn-sm">
                            View Details
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p>No vegetables added yet. Click "Add Vegetable" to get started.</p>
}
