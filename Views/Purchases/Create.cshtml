 @model DailyVegetableTracker.Models.Purchase

@{
    ViewData["Title"] = "Add Purchase";
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="fw-bold">Add Purchase</h1>
        <p class="text-muted">Record your vegetable spending.</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="VegetableId" class="form-label">
                        Vegetable
                    </label>
                    <select asp-for="VegetableId"
                            asp-items="ViewBag.VegetableId"
                            class="form-select">
                        <option value="">-- Select a vegetable --</option>
                    </select>
                    <span asp-validation-for="VegetableId"
                          class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Quantity" class="form-label">
                            Quantity
                        </label>
                        <input asp-for="Quantity"
                               type="number"
                               min="0.01"
                               max="100000"
                               step="0.001"
                               class="form-control"
                               id="quantity"
                               placeholder="e.g. 2.500" />
                        <span asp-validation-for="Quantity"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="PricePerUnit" class="form-label">
                            Price per unit (₹)
                        </label>
                        <input asp-for="PricePerUnit"
                               type="number"
                               min="0.01"
                               max="1000000"
                               step="0.01"
                               class="form-control"
                               id="price"
                               placeholder="e.g. 40.00" />
                        <span asp-validation-for="PricePerUnit"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Unit" class="form-label">Unit</label>
                    <input asp-for="Unit"
                           class="form-control"
                           id="unit"
                           readonly />
                    <span asp-validation-for="Unit"
                          class="text-danger"></span>
                    <small class="text-muted">
                        The unit is set automatically from the selected vegetable.
                    </small>
                </div>

                <div class="mb-3">
                    <label asp-for="PurchaseDate" class="form-label">
                        Purchase Date
                    </label>
                    <input asp-for="PurchaseDate"
                           type="date"
                           asp-format="{0:yyyy-MM-dd}"
                           class="form-control" />
                    <span asp-validation-for="PurchaseDate"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ShopName" class="form-label">
                        Shop Name (Optional)
                    </label>
                    <input asp-for="ShopName"
                           class="form-control"
                           placeholder="e.g. Local vegetable shop" />
                    <span asp-validation-for="ShopName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Notes" class="form-label">
                        Notes (Optional)
                    </label>
                    <textarea asp-for="Notes"
                              class="form-control"
                              rows="3"
                              placeholder="Add any additional notes"></textarea>
                    <span asp-validation-for="Notes"
                          class="text-danger"></span>
                </div>

                <div class="alert alert-success">
                    <span class="fw-semibold">Estimated Total Cost:</span>
                    <span id="totalCost" class="fw-bold">₹0.00</span>
                    <div class="small">
                        Quantity × Price per unit
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        Save Purchase
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const quantityInput = document.getElementById("quantity");
        const priceInput = document.getElementById("price");
        const totalCost = document.getElementById("totalCost");

        function updateTotal() {
            const quantity = Number(quantityInput.value) || 0;
            const price = Number(priceInput.value) || 0;
            const total = quantity * price;

            totalCost.textContent = "₹" + total.toLocaleString("en-IN", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }

        quantityInput.addEventListener("input", updateTotal);
        priceInput.addEventListener("input", updateTotal);

        updateTotal();
    </script>
}