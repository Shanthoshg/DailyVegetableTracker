 @model DailyVegetableTracker.Models.Purchase

@{
    ViewData["Title"] = "Delete Purchase";
}

<div class="container py-4">
    <h1 class="fw-bold text-danger">Delete Purchase</h1>
    <p class="text-muted">Review the details before deleting this record.</p>

    <div class="alert alert-warning">
        Are you sure you want to delete this purchase? This action cannot be undone.
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 class="mb-0">Purchase Details</h5>
        </div>

        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Purchase ID</dt>
                <dd class="col-sm-8">@Model.Id</dd>

                <dt class="col-sm-4">Vegetable</dt>
                <dd class="col-sm-8">@(Model.Vegetable?.Name ?? "Unknown")</dd>

                <dt class="col-sm-4">Quantity</dt>
                <dd class="col-sm-8">@Model.Quantity.ToString("N3") @Model.Unit</dd>

                <dt class="col-sm-4">Price per Unit</dt>
                <dd class="col-sm-8">₹@Model.PricePerUnit.ToString("N2")</dd>

                <dt class="col-sm-4">Total Cost</dt>
                <dd class="col-sm-8 fw-bold text-danger">
                    ₹@Model.TotalCost.ToString("N2")
                </dd>

                <dt class="col-sm-4">Purchase Date</dt>
                <dd class="col-sm-8">@Model.PurchaseDate.ToString("dd MMM yyyy")</dd>

                <dt class="col-sm-4">Shop</dt>
                <dd class="col-sm-8">
                    @(string.IsNullOrWhiteSpace(Model.ShopName) ? "—" : Model.ShopName)
                </dd>

                <dt class="col-sm-4">Notes</dt>
                <dd class="col-sm-8">
                    @(string.IsNullOrWhiteSpace(Model.Notes) ? "—" : Model.Notes)
                </dd>
            </dl>
        </div>
    </div>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">
            Yes, Delete Purchase
        </button>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Cancel
        </a>
    </form>
</div>