
@model DailyVegetableTracker.Models.Vegetable

@{
    ViewData["Title"] = "Edit Vegetable";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Edit Vegetable</h4>
                </div>

                <div class="card-body">
                    <form asp-action="Edit"
                          asp-route-id="@Model.Id"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="Name"
                                   class="form-label">Vegetable Name</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Category"
                                   class="form-label">Category</label>
                            <input asp-for="Category" class="form-control" />
                            <span asp-validation-for="Category"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Unit"
                                   class="form-label">Default Unit</label>
                            <select asp-for="Unit" class="form-select">
                                <option value="kg">Kilogram (kg)</option>
                                <option value="g">Gram (g)</option>
                                <option value="piece">Piece</option>
                                <option value="bunch">Bunch</option>
                                <option value="dozen">Dozen</option>
                            </select>
                            <span asp-validation-for="Unit"
                                  class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                Update Vegetable
                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
